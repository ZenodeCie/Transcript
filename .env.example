# ─── Serveur HTTP ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8787
# URL publique utilisée pour construire les liens signés (sans slash final).
# Laisser vide pour dériver l'origine de la requête (Host / X-Forwarded-*).
PUBLIC_URL=
TRUST_PROXY=false

# ─── Secrets (obligatoires) ──────────────────────────────────────────────────
# Générer : openssl rand -hex 32
API_KEY=
# Générer : openssl rand -hex 48
SIGNING_SECRET=

# ─── Stockage / rétention ────────────────────────────────────────────────────
DATA_DIR=./data
DEFAULT_TTL=7d
MAX_TTL=30d
PURGE_INTERVAL_MS=3600000
MAX_BODY_BYTES=33554432
MAX_MESSAGES=10000
RATE_LIMIT_PER_MINUTE=30

# ─── Source Discord (optionnelle) ────────────────────────────────────────────
# Sans token, le service accepte uniquement les messages fournis en JSON.
DISCORD_BOT_TOKEN=
DISCORD_API_BASE=https://discord.com/api/v10
FETCH_CONCURRENCY=4

# ─── Pièces jointes ──────────────────────────────────────────────────────────
# Télécharge les pièces jointes Discord et les incruste dans le transcript
# (les URLs CDN Discord expirent ; l'incrustation rend le HTML durable).
INLINE_ASSETS=true
MAX_ASSET_BYTES=8388608
MAX_TOTAL_ASSET_BYTES=33554432

# ─── Divers ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Origine autorisée pour les appels navigateur (laisser vide = aucun CORS).
CORS_ORIGIN=
