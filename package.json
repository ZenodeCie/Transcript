{
  "name": "zenode-transcript",
  "version": "0.1.1",
  "description": "ZenodeBots web transcript service — renders Discord ticket transcripts as signed, self-contained HTML pages.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop zenode-transcript",
    "pm2:logs": "pm2 logs zenode-transcript"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
